<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      There is deliberately no INTERNET permission. Naomi cannot send a transcript
      anywhere, and that is enforced by the OS rather than promised in a document.
      Speech recognition and understanding both run on-device.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required by AudioProcessingService.triggerHaptic; without it every
         haptic failed silently behind a catch block. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      Alarms do not survive a reboot, so without this a reminder set on Tuesday
      for Friday is lost by a restart on Wednesday — silently, with the task
      still sitting in the app looking handled.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      Only meaningful once Naomi could hear a clock time, which it now can.
      "Remind me at 6 PM" delivered any time before seven is a broken promise;
      "by Friday" resolved to a 09:00 Naomi chose is not, and still gets an
      inexact alarm. The permission is requested at the first reminder that
      actually needs it, never at launch, and being refused leaves the inexact
      behaviour Naomi had until now. See ReminderScheduler.

      This is the only permission this work adds. The calendar integration adds
      none: Naomi hands the event to the user's own calendar app rather than
      taking read access to every appointment they have ever had.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
      Network permissions are stripped in src/offline/AndroidManifest.xml, which
      applies to the default flavour and therefore to the published APK.

      They are not stripped here because this manifest is shared with the
      `connected` flavour, whose entire purpose is to have network access. Doing
      it per-flavour is what lets the offline build's claim stay absolute
      instead of becoming "unless a setting is on".
    -->

    <!--
      allowBackup is false because Android's auto-backup would copy the
      transcript database to the user's Google Drive, which would contradict
      the on-device promise the rest of the app keeps.
    -->
    <application
        android:name=".NaomiApp"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.naomi.app.ACTION_QUICK_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!--
              Share Sheet. Text and links shared from anywhere become memories,
              filed the same way speech is. Only text/plain is accepted, because
              that is the only thing Naomi can actually understand — claiming
              other types and then discarding them would be worse than not
              appearing in the sheet at all.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Foreground Audio Service -->
        <service
            android:name=".audio.AudioProcessingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!--
          Reminders. Both are exported="false": nothing outside Naomi has any
          business firing a reminder or asking it to reschedule. BootReceiver is
          the one exception the system itself needs, and the boot broadcast is
          delivered to non-exported receivers all the same.
        -->
        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          Home screen AppWidget.

          Exported because an AppWidgetProvider must be — the launcher lives in
          another process and has to be able to send it APPWIDGET_UPDATE.

          It used to carry ACTION_WIDGET_TAP in this same filter, which meant
          any app on the device could start or stop a recording by sending one
          broadcast. Tap handling now lives in a separate, non-exported receiver
          reached by explicit component.
        -->
        <receiver
            android:name=".widget.NaomiWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/naomi_widget_info" />
        </receiver>

        <!--
          The only thing that can start a capture from the home screen. Not
          exported: the only sender that reaches it is Naomi's own PendingIntent,
          which carries this app's identity.
        -->
        <receiver
            android:name=".widget.WidgetTapReceiver"
            android:exported="false" />

        <!--
          Per-widget appearance. `exported` is true because the *launcher*
          starts it when a widget is placed; it does nothing on its own and
          refuses to act without a valid widget id handed to it by the host.
        -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_config_title"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>

</manifest>
