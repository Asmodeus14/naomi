<resources>
    <!--
      The widget cannot use the Compose palette, so these are the one place a
      Naomi colour is written twice. Every value here mirrors a named colour in
      theme/Color.kt; if one changes, change both.

      Six unused legacy colours (naomi_black, naomi_white, naomi_muted and
      friends) were removed from this file. They disagreed with the Compose
      palette — naomi_black was #0D0E11 against the theme's #111318 — and
      nothing read them, so they served only to make "what colour is Naomi"
      ambiguous.
    -->

    <!--
      Semantic accents, shared with NaomiAccents in Compose.

      These used to be a single value each, and the value matched neither theme:
      the listening red was #E05252 against AccentListeningLight's #C5433F and
      AccentListeningDark's #EB6B67. On a light widget background that also
      failed WCAG AA, so the one element in the widget that has to be
      unmistakable — "I am recording you" — was the least legible thing on it.
      They are now per-theme and identical to the app's.
    -->
    <color name="naomi_listening_red">#C5433F</color>
    <color name="naomi_success_green">#2F855A</color>
    <color name="naomi_amber">#9A6B12</color>

    <!-- Widget surface tokens (light). Mirrors StitchLight* in Color.kt. -->
    <color name="widget_background">#FBF9FA</color>
    <color name="widget_surface">#F5F3F4</color>
    <color name="widget_stroke">#C4C7CC</color>
    <!-- The slate accent, so the widget orb is recognisably the app's orb. -->
    <color name="widget_orb_idle">#4E5E6D</color>
    <color name="widget_orb_halo">#1A4E5E6D</color>
    <color name="widget_text_primary">#1B1C1D</color>
    <color name="widget_text_secondary">#43474C</color>
    <color name="widget_text_tertiary">#74777C</color>

    <!--
      Theme-independent copies, for a widget the user pinned to Light or Dark.

      The references above resolve against whoever inflates them, which is what
      makes System theme track the device correctly. An explicit override needs
      the opposite: a value that does *not* move. These are the same colours,
      addressable by name so the provider can send a fixed one.
    -->
    <color name="widget_background_light">#FBF9FA</color>
    <color name="widget_text_primary_light">#1B1C1D</color>
    <color name="widget_text_secondary_light">#43474C</color>
    <color name="widget_text_tertiary_light">#74777C</color>

    <color name="widget_background_dark">#111318</color>
    <color name="widget_text_primary_dark">#EDEDF0</color>
    <color name="widget_text_secondary_dark">#9AA0AB</color>
    <color name="widget_text_tertiary_dark">#6B7280</color>
</resources>
