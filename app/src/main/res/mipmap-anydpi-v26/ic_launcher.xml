<?xml version="1.0" encoding="utf-8"?>
<!--
  This was a plain <vector> — a dark square with a white dot — which meant the
  launcher could not mask it to the device's icon shape, the "round" variant was
  byte-identical to the square one, and Android 13's themed icons had no
  monochrome layer to use and fell back to a washed-out square.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
