<?xml version="1.0" encoding="utf-8"?>
<!--
  System theme. The colour is a *reference*, resolved by whichever process
  inflates this — so values-night applies on its own and a system theme flip
  redraws correctly. Baking an ARGB int here is what made the old widget go
  stale until something else happened to update it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <solid android:color="@color/widget_background" />
    <stroke android:width="1dp" android:color="@color/widget_stroke" />
</shape>
