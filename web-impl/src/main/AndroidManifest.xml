<?xml version="1.0" encoding="utf-8"?>
<!--
  This is the one manifest in the repository that asks for network access, and
  it is only merged into the `connected` flavour of the app.

  The `offline` flavour does not depend on this module at all, which is what
  keeps `checkOfflineReleaseHasNoNetworkPermission` passing and the README's
  claim about the default build true.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
