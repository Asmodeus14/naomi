# Copy to keystore.properties and fill in. That file is gitignored; this one is not.
#
# storeFile should point OUTSIDE this repository. Keeping the keystore out of the
# working tree is what makes committing it impossible rather than merely
# forbidden. ~/.android-keystores/ is a reasonable home for it.
#
# On Windows, escape backslashes (C:\\Users\\you\\...) or just use forward slashes.

storeFile=/path/to/naomi-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
