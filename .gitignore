# Gradle / build output
.gradle/
build/
app/build/
.cxx/
.externalNativeBuild/
.kotlin/
captures/
# The Eclipse/VS Code Java tooling drops compiled output here, outside build/.
bin/

# Build artifacts. A 19MB APK was previously committed at the repository root;
# releases are published by CI, never carried in the tree.
*.apk
*.aab
*.ap_
*.dex

# Signing material. Nothing here should ever exist in this repository.
# keystore.properties.example is the one exception: placeholders only.
*.jks
*.keystore
*.p12
*.pem
*.key
keystore.properties
!keystore.properties.example
secrets.xml
google-services.json

# Store-publishing credentials. Naomi ships through GitHub Releases and uses
# none of these today, but a service-account JSON grants upload rights to a
# listing, and the cost of keeping the patterns is nothing.
service-account.json
play-service-account*.json
*-service-account.json
google-play-*.json

# Environment files
.env
.env.*
!.env.example

# Machine-local configuration
local.properties
*.iml
.idea/
*.log
*.tmp

# OS
.DS_Store
Thumbs.db
